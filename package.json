    "audio:upload": "node scripts/upload-r2.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "astro": "^4.15.0",
    "fuse.js": "^7.0.0"
  },
  "devDependencies": {
    "yaml": "^2.5.0"
