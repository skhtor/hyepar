{
  "name": "hyepar",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "A living archive of Armenian traditional dance, and a teacher's practice tool.",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run data:build && astro build",
    "preview": "astro preview",
